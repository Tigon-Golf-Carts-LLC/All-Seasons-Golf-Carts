# Copy to .env.local for local overrides. All values are baked in at build time.

# Sub-path the site is served from. "/" for a custom domain or Cloudflare Pages;
# the repository name for a GitHub Pages project page.
BASE_PATH=/

# Origin used for canonical tags, Open Graph URLs, sitemap.xml and robots.txt.
VITE_SITE_URL=https://allseasonsgolfcarts.com

# Where the contact form POSTs. Leave empty to fall back to a mailto: link.
# Examples: https://formspree.io/f/xxxxxxx  |  /api/contact (Cloudflare Pages)
VITE_CONTACT_ENDPOINT=
